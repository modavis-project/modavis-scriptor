{
  "name": "modavis-scriptor",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-aware transcription and review workbench for document and image sources.",
  "repository": {
    "type": "git",
    "url": "https://github.com/modavis-project/modavis-scriptor.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build && npm audit",
    "test:assets": "python3 scripts/graphics/verify-assets.py",
    "verify:assets": "npm run test:assets",
    "test:browser": "playwright test",
    "test:api": "python3 scripts/graphics/test-api.py",
    "test:backend": "python3 scripts/graphics/test-backend.py",
    "test:pipeline": "python3 scripts/graphics/test-pipeline.py",
    "doctor": "python3 scripts/dev/doctor.py",
    "test:integration": "python3 scripts/dev/validate.py",
    "test:evaluation": "python3 scripts/evaluation/test-score.py"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-server-dom-webpack": "19.3.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.4.0",
    "wrangler": "4.156.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261030.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-rsc": "0.5.38",
    "oxfmt": "0.75.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    },
    "@shuding/opentype.js": {
      "fflate": "0.7.5"
    }
  }
}
